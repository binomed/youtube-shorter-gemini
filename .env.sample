# YouTube Shorter Gemini - Environment Configuration Template
# Copy this file to .env and fill in your values

# Backend Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
# Set to 'true' to use Gemini for subtitle generation instead of the default local WhisperX execution
USE_GEMINI_SUBTITLES=false

# Ollama Configuration (for local AI processing)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:7b

# Database Configuration
DATABASE_PATH=./data/youtube-shorter.db

# Video Upload Configuration
# Maximum video file size in MB (default: 2048 = 2GB)
MAX_VIDEO_SIZE_MB=2048
